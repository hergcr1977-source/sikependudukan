generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MULTI-RT: Tabel Referensi ============

model RukunTetangga {
  id         Int       @id @default(autoincrement())
  namaRT     String    @default("001")
  rw         String    @default("002")
  kelurahan  String    @default("SUKAMAJU")
  kecamatan  String    @default("CIBUNGBULANG")
  kabupaten  String    @default("BOGOR")
  provinsi   String    @default("JAWA BARAT")
  alamat     String    @default("KP. CEMPLANG")
  ketuaRT    String?
  aktif      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AppUser {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  password   String
  nama       String
  role       String    @default("user") // superadmin, admin, user
  rtId       Int?
  aktif      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ============ TABEL DATA (dengan rtId) ============

model Penduduk {
  id               Int       @id @default(autoincrement())
  rtId             Int       @default(1)
  noKK             String
  nik              String    @unique
  namaLengkap      String
  jenisKelamin     String
  statusKeluarga   String
  tempatLahir      String
  tanggalLahir     DateTime
  agama            String
  pendidikan       String
  pekerjaan        String
  statusPerkawinan String
  kewarganegaraan  String
  namaAyah         String
  namaIbu          String
  namaPanggilan    String?
  noHP             String?
  punyaKTP         String    @default("BELUM")
  bantuan          String    @default("[]")
  bpjs             String?
  desil            String?
  alamat           String    @default("KP. CEMPLANG")
  rt               String    @default("001")
  rw               String    @default("002")
  kelurahan        String    @default("SUKAMAJU")
  kecamatan        String    @default("CIBUNGBULANG")
  kabupaten        String    @default("BOGOR")
  provinsi         String    @default("JAWA BARAT")
  keterangan       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PendudukSementara {
  id                Int       @id @default(autoincrement())
  rtId              Int       @default(1)
  noKK              String
  nik               String    @unique
  namaLengkap       String
  jenisKelamin      String
  statusKeluarga    String
  tempatLahir       String
  tanggalLahir      DateTime
  agama             String
  pendidikan        String
  pekerjaan         String
  statusPerkawinan  String
  kewarganegaraan   String
  namaAyah          String
  namaIbu           String
  namaPanggilan     String?
  noHP              String?
  statusKeterangan  String
  alamatAsal        String
  bantuan           String    @default("[]")
  bpjs              String?
  alamat            String    @default("KP. CEMPLANG")
  rt                String    @default("001")
  rw                String    @default("002")
  kelurahan         String    @default("SUKAMAJU")
  kecamatan         String    @default("CIBUNGBULANG")
  kabupaten         String    @default("BOGOR")
  provinsi          String    @default("JAWA BARAT")
  tanggalMasuk      DateTime
  tanggalKeluar     DateTime?
  keterangan        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LaporanBulanan {
  id         Int      @id @default(autoincrement())
  rtId       Int      @default(1)
  bulan      Int
  tahun      Int
  data       String   // JSON string of report data
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([rtId, bulan, tahun])
}

model Kejadian {
  id            Int       @id @default(autoincrement())
  rtId          Int       @default(1)
  jenisKejadian String
  noKK          String
  namaLengkap   String
  nik           String?
  jenisKelamin  String
  tanggal       DateTime
  keterangan    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KasRT {
  id         Int      @id @default(autoincrement())
  rtId       Int      @default(1)
  tanggal    DateTime
  jenis      String
  jumlah     Int
  keterangan String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PenerimaSembako {
  id             Int      @id @default(autoincrement())
  rtId           Int      @default(1)
  noKK           String
  nik            String
  namaLengkap    String
  jenisKelamin   String
  statusKeluarga String
  tanggalLahir   String
  alamat         String   @default("KP. CEMPLANG")
  rt             String   @default("001")
  rw             String   @default("002")
  keterangan     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SembakoSnapshot {
  id               Int      @id @default(autoincrement())
  rtId             Int      @default(1)
  nama             String
  jumlahPenerima   Int
  data             String   // JSON array of PenerimaSembako
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
